{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "ignoreTests": true,
  "argocd": {
    "managerFilePatterns": ["/^argocd-apps/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^(apps|add-ons)/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^bootstrap/kustomization\\.yaml$/"],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/(?<depName>argoproj/argo-cd)/(?<currentValue>v[\\d.]+)/manifests/install\\.yaml"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^add-ons/postgres/cluster\\.yaml$/"],
      "matchStrings": ["imageName: (?<depName>[^:\\s]+):(?<currentValue>\\S+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for every update",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "separateMajorMinor": false
    },
    {
      "description": "Built from commits and rolled out by hand or by Image Updater",
      "matchPackageNames": ["ghcr.io/whyredfire/**"],
      "enabled": false
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_v[\\d.]+-ls(?<build>\\d+)$"
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/jackett"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "The operator and Pocket ID move to v3 together, so review them by hand",
      "matchPackageNames": ["ghcr.io/aclerici38/charts/pocket-id-operator", "ghcr.io/pocket-id/pocket-id"],
      "groupName": "pocket-id",
      "groupSlug": "pocket-id",
      "automerge": false
    },
    {
      "description": "The operator crash-loops on Pocket ID v3 until it supports it",
      "matchPackageNames": ["ghcr.io/pocket-id/pocket-id"],
      "allowedVersions": "<3.0.0"
    }
  ]
}
